<Window x:Class="RevitConduitAddin.DialuxFixtureSettings"
        xmlns="http://schemas.microsoft.com/winfx/2000/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2000/xaml"
        Title="DIALux Fixture Import Settings" Height="420" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="DIALux Fixture Import Configuration"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Fuzzy Match Threshold -->
        <Grid Grid.Row="1" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Label Content="Fuzzy Match Threshold:" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Slider x:Name="FuzzySlider" Minimum="0.3" Maximum="0.95" Value="0.60"
                        IsSnapToTickEnabled="True" TickFrequency="0.05"/>
                <TextBlock x:Name="FuzzyValue" Text="0.60" Margin="5,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Area Tolerance -->
        <Grid Grid.Row="2" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Label Content="Area Tolerance (%):" VerticalAlignment="Center"/>
            <TextBox x:Name="AreaToleranceBox" Text="15" Grid.Column="1"
                     VerticalAlignment="Center"/>
        </Grid>

        <!-- Mounting Height -->
        <Grid Grid.Row="3" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Label Content="Mounting Height (m):" VerticalAlignment="Center"/>
            <TextBox x:Name="MountingHeightBox" Text="2.5" Grid.Column="1"
                     VerticalAlignment="Center"/>
        </Grid>

        <!-- Skip Existing -->
        <CheckBox Grid.Row="4" x:Name="SkipExistingCheck"
                  Content="Skip fixtures that already exist in the model"
                  IsChecked="True" Margin="0,10"/>

        <!-- Auto-Generate Grid -->
        <CheckBox Grid.Row="5" x:Name="AutoGridCheck"
                  Content="Auto-generate grid layout if no positions available"
                  IsChecked="True" Margin="0,5"/>

        <!-- Status/Log -->
        <Border Grid.Row="6" BorderBrush="Gray" BorderThickness="1"
                Margin="0,10,0,0" Padding="5">
            <TextBlock x:Name="StatusText" Text="Ready to configure..."
                       TextWrapping="Wrap" FontFamily="Consolas" FontSize="10"
                       VerticalAlignment="Top" MinHeight="60"/>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button x:Name="OKButton" Content="OK" Width="80" Height="30"
                    Click="OKButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
